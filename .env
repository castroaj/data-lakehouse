# Kafka — local Docker Compose instance
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=events
KAFKA_GROUP_ID=lakehouse-local
KAFKA_STARTING_OFFSETS=earliest

# S3 — update bucket name to match your local or dev bucket
S3_BUCKET_NAME=lakehouse-local
AWS_REGION=us-east-1

# Delta Lake paths (relative to bucket root)
DELTA_TABLE_PATH=lakehouse/events
CHECKPOINT_PATH=checkpoints/events
DEAD_LETTER_PATH=dead-letter/events

# Spark — local mode
SPARK_MASTER=local[*]
SPARK_APP_NAME=lakehouse-ingestion-local
